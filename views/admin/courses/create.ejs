
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Course | Excellence Club</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen">

    <nav class="bg-gray-900 text-white px-6 py-4 flex justify-between items-center">
        <h1 class="text-xl font-bold">Excellence Club</h1>

        <a href="/admin/courses" class="text-sm hover:text-blue-300">
            Back to Courses
        </a>
    </nav>

    <main class="max-w-3xl mx-auto px-6 py-10">

        <div class="mb-8">
            <h2 class="text-3xl font-bold text-gray-800">Create New Course</h2>
            <p class="text-gray-500 mt-2">
                Add a new course for Excellence Club students.
            </p>
        </div>

        <div class="bg-white rounded-xl shadow-sm p-6 md:p-8">

            <form id="courseForm" class="space-y-6">

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Course Title
                    </label>
                    <input
                        type="text"
                        name="title"
                        required
                        placeholder="Example: Complete Mathematics"
                        class="w-full border border-gray-300 rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500"
                    >
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Subject
                    </label>
                    <input
                        type="text"
                        name="subject"
                        required
                        placeholder="Example: Mathematics"
                        class="w-full border border-gray-300 rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500"
                    >
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Select Class
                    </label>
                    <select
                        name="class"
                        required
                        class="w-full border border-gray-300 rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500"
                    >
                        <option value="">Choose Class</option>
                        <option value="9th">Class 9th</option>
                        <option value="10th">Class 10th</option>
                        <option value="11th">Class 11th</option>
                        <option value="12th">Class 12th</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Course Description
                    </label>
                    <textarea
                        name="description"
                        required
                        rows="5"
                        placeholder="Write a short description about this course..."
                        class="w-full border border-gray-300 rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500"
                    ></textarea>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Thumbnail Image URL
                    </label>
                    <input
                        type="url"
                        name="thumbnail"
                        placeholder="https://example.com/image.jpg"
                        class="w-full border border-gray-300 rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500"
                    >
                    <p class="text-xs text-gray-500 mt-2">
                        Optional: Add a course thumbnail image URL.
                    </p>
                </div>

                <div class="flex flex-wrap gap-3 pt-4">
                    <button
                        type="submit"
                        class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium"
                    >
                        Create Course
                    </button>

                    <a
                        href="/admin/courses"
                        class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-6 py-3 rounded-lg font-medium"
                    >
                        Cancel
                    </a>
                </div>

                <p id="message" class="text-sm font-medium"></p>

            </form>

        </div>

    </main>

<script>
    const courseForm = document.getElementById("courseForm");
    const message = document.getElementById("message");

    courseForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const formData = new FormData(courseForm);

        const courseData = {
            title: formData.get("title"),
            subject: formData.get("subject"),
            class: formData.get("class"),
            description: formData.get("description"),
            thumbnail: formData.get("thumbnail")
        };

        try {
            message.textContent = "Creating course...";
            message.className = "text-sm font-medium text-blue-600";

            const response = await fetch("/admin/courses", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(courseData)
            });

            const result = await response.json();

            if (!response.ok) {
                throw new Error(result.message || "Course creation failed");
            }

            message.textContent = "Course created successfully!";
            message.className = "text-sm font-medium text-green-600";

            courseForm.reset();

            setTimeout(() => {
                window.location.href = "/admin/courses";
            }, 1000);

        } catch (error) {
            message.textContent = error.message;
            message.className = "text-sm font-medium text-red-600";
        }
    });
</script>
</body>
</html>

