
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= course.title %> | Excellence Club</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>

<body class="bg-slate-50 text-slate-800">

    <!-- Navbar -->
    <nav class="bg-white border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-5 py-4 flex justify-between items-center">

            <a href="/student/dashboard" class="text-xl font-extrabold text-indigo-700">
                Excellence<span class="text-slate-800">Club.</span>
            </a>

            <div class="flex items-center gap-4">
                <span class="hidden sm:block text-sm text-slate-500">
                    Welcome, <%= student.fullName %>
                </span>

                <a href="/student/dashboard"
                   class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-semibold transition">
                    Dashboard
                </a>
            </div>

        </div>
    </nav>


    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-5 py-10">

        <!-- Breadcrumb -->
        <div class="mb-7">
            <a href="/student/dashboard"
               class="text-sm text-indigo-600 hover:text-indigo-800 font-medium">
                ← Back to Dashboard
            </a>
        </div>


        <!-- Course Hero -->
        <section class="bg-white rounded-3xl overflow-hidden border border-slate-200 shadow-sm">

            <div class="grid md:grid-cols-2">

                <!-- Course Thumbnail -->
                <div class="bg-gradient-to-br from-indigo-600 to-violet-700 min-h-64 flex items-center justify-center">

                    <% if (course.thumbnail) { %>

                        <img
                            src="<%= course.thumbnail %>"
                            alt="<%= course.title %>"
                            class="w-full h-full min-h-64 max-h-96 object-cover"
                        >

                    <% } else { %>

                        <div class="text-center text-white p-10">
                            <div class="text-6xl mb-4">📚</div>
                            <p class="text-xl font-bold">Excellence Club</p>
                            <p class="text-indigo-100 text-sm mt-2">Learn • Grow • Achieve</p>
                        </div>

                    <% } %>

                </div>


                <!-- Course Information -->
                <div class="p-8 md:p-12 flex flex-col justify-center">

                    <div class="flex flex-wrap gap-2 mb-5">

                        <span class="bg-indigo-50 text-indigo-700 px-3 py-1 rounded-full text-xs font-bold">
                            Class <%= course.class %>
                        </span>

                        <span class="bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full text-xs font-bold">
                            <%= course.subject %>
                        </span>

                    </div>

                    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 leading-tight">
                        <%= course.title %>
                    </h1>

                    <p class="text-slate-500 mt-5 leading-7">
                        <%= course.description %>
                    </p>

                    <div class="mt-8 flex flex-wrap gap-3">

                        <a href="/student/dashboard"
                           class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-xl font-semibold transition">
                            Back to My Courses
                        </a>

                    </div>

                </div>

            </div>

        </section>


        <!-- Course Details -->
        <section class="mt-10">

            <h2 class="text-2xl font-bold text-slate-900 mb-6">
                Course Information
            </h2>

            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">

                <div class="bg-white border border-slate-200 rounded-2xl p-6">
                    <p class="text-sm text-slate-400 font-medium">Course Name</p>
                    <h3 class="font-bold text-slate-800 mt-2">
                        <%= course.title %>
                    </h3>
                </div>

                <div class="bg-white border border-slate-200 rounded-2xl p-6">
                    <p class="text-sm text-slate-400 font-medium">Subject</p>
                    <h3 class="font-bold text-slate-800 mt-2">
                        <%= course.subject %>
                    </h3>
                </div>

                <div class="bg-white border border-slate-200 rounded-2xl p-6">
                    <p class="text-sm text-slate-400 font-medium">Your Class</p>
                    <h3 class="font-bold text-slate-800 mt-2">
                        Class <%= course.class %>
                    </h3>
                </div>

            </div>

        </section>


        <!-- Learning Materials Placeholder -->
        <section class="mt-10 bg-white border border-slate-200 rounded-2xl p-8">

            <div class="flex items-center gap-3 mb-3">
                <span class="text-2xl">📖</span>

                <h2 class="text-xl font-bold text-slate-900">
                    Learning Materials
                </h2>
            </div>

            <p class="text-slate-500 leading-7">
                Study notes, video lectures, assignments and other learning
                materials will be available here when they are added by the admin.
            </p>

            <div class="mt-5 inline-block bg-amber-50 text-amber-700 px-4 py-2 rounded-lg text-sm font-semibold">
                Learning materials coming soon
            </div>

        </section>


        <!-- Footer -->
        <footer class="text-center text-sm text-slate-400 mt-14 pb-6">
            © <%= new Date().getFullYear() %> Excellence Club. All rights reserved.
            <p class="mt-2">Learn • Grow • Achieve</p>
        </footer>

    </main>

</body>
</html>
