
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Registration | Excellence Club</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gray-100 flex items-center justify-center p-4">

    <div class="bg-white w-full max-w-lg p-8 rounded-2xl shadow-lg">

        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-blue-700">
                Excellence Club
            </h1>

            <p class="text-gray-500 mt-2">
                Create Your Student Account
            </p>
        </div>

        <form id="studentRegisterForm" class="space-y-4">

            <div>
                <label class="block text-gray-700 mb-2">Full Name</label>
                <input type="text" id="fullName" required
                    placeholder="Enter your full name"
                    class="w-full border rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label class="block text-gray-700 mb-2">Email Address</label>
                <input type="email" id="email" required
                    placeholder="Enter your email"
                    class="w-full border rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label class="block text-gray-700 mb-2">Class</label>
                <select id="class" required
                    class="w-full border rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500">

                    <option value="">Select Your Class</option>
                    <option value="9th">Class 9th</option>
                    <option value="10th">Class 10th</option>
                    <option value="11th">Class 11th</option>
                    <option value="12th">Class 12th</option>

                </select>
            </div>

            <div>
                <label class="block text-gray-700 mb-2">Password</label>
                <input type="password" id="password" required minlength="8"
                    placeholder="Minimum 8 characters"
                    class="w-full border rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label class="block text-gray-700 mb-2">Confirm Password</label>
                <input type="password" id="confirmPassword" required
                    placeholder="Confirm your password"
                    class="w-full border rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <p id="message" class="text-sm text-center"></p>

            <button type="submit" id="registerButton"
                class="w-full bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-lg font-semibold transition">
                Create Account
            </button>

        </form>

        <p class="text-center text-gray-600 mt-6">
            Already have an account?

            <a href="/student/login"
                class="text-blue-600 font-semibold hover:underline">
                Login Now
            </a>
        </p>

        <p class="text-center mt-4">
            <a href="/" class="text-gray-500 hover:text-blue-600">
                Back to Home
            </a>
        </p>

    </div>

    <script>
        const registerForm = document.getElementById("studentRegisterForm");
        const message = document.getElementById("message");
        const registerButton = document.getElementById("registerButton");

        registerForm.addEventListener("submit", async (e) => {
            e.preventDefault();

            const fullName = document.getElementById("fullName").value.trim();
            const email = document.getElementById("email").value.trim();
            const studentClass = document.getElementById("class").value;
            const password = document.getElementById("password").value;
            const confirmPassword = document.getElementById("confirmPassword").value;

            if (password !== confirmPassword) {
                message.textContent = "Passwords do not match!";
                message.className = "text-sm text-center text-red-600";
                return;
            }

            registerButton.disabled = true;
            registerButton.textContent = "Creating Account...";

            try {
                const response = await fetch("/api/auth/register", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        fullName,
                        email,
                        class: studentClass,
                        password,
                        confirmPassword
                    })
                });

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.message || "Registration failed");
                }

                message.textContent = "Registration successful! Redirecting...";
                message.className = "text-sm text-center text-green-600";

                setTimeout(() => {
                    window.location.href = "/student/dashboard";
                }, 1000);

            } catch (error) {
                message.textContent = error.message;
                message.className = "text-sm text-center text-red-600";

            } finally {
                registerButton.disabled = false;
                registerButton.textContent = "Create Account";
            }
        });
    </script>

</body>
</html>
