<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Dashboard | Excellence Club</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .sidebar-link {
            transition: all .2s ease;
        }

        .sidebar-link:hover {
            background: rgba(255, 255, 255, .09);
            color: #fff;
        }

        .sidebar-link.active {
            background: #eef2ff;
            color: #4338ca;
            font-weight: 600;
        }

        .soft-card {
            box-shadow: 0 10px 35px rgba(15, 23, 42, .045);
        }

        .field {
            width: 100%;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 12px 14px;
            outline: none;
            background: #fff;
            transition: .2s;
        }

        .field:focus {
            border-color: #818cf8;
            box-shadow: 0 0 0 3px rgba(129, 140, 248, .15);
        }
    </style>
</head>

<body class="min-h-screen bg-[#f6f7fb] text-slate-800">

    <% const displayName=student && student.fullName ? student.fullName : "Student" ; const
        firstName=displayName.trim().split(/\s+/)[0]; const courseCount=Array.isArray(courses) ? courses.length : 0;
        const accountIsActive=Boolean(student && student.isActive); %>

        <div class="min-h-screen md:flex">

            <!-- Desktop Sidebar -->
            <aside
                class="hidden md:flex md:fixed md:inset-y-0 md:left-0 md:z-40 md:w-72 md:flex-col bg-[#171b35] text-white">
                <div class="px-7 py-7 border-b border-white/10">
                    <a href="/" class="flex items-center gap-3">
                        <div
                            class="h-11 w-11 rounded-2xl bg-indigo-500 flex items-center justify-center font-black text-lg shadow-lg shadow-indigo-950/30">
                            EC</div>
                        <div>
                            <p class="text-xl font-extrabold tracking-tight">Excellence <span
                                    class="text-indigo-300">Club</span></p>
                            <p class="text-[11px] uppercase tracking-[.18em] text-slate-400 mt-1">Student learning space
                            </p>
                        </div>
                    </a>
                </div>

                <div class="px-5 pt-7 pb-3">
                    <p class="px-3 text-[10px] font-bold uppercase tracking-[.2em] text-slate-500">Workspace</p>
                </div>

                <nav class="px-4 space-y-1.5">
                    <a href="#overview"
                        class="sidebar-link active flex items-center gap-3 rounded-xl px-4 py-3 text-sm text-slate-300">
                        <i data-lucide="layout-dashboard" class="h-[18px] w-[18px]"></i> Overview
                    </a>
                    <a href="#courses"
                        class="sidebar-link flex items-center gap-3 rounded-xl px-4 py-3 text-sm text-slate-300">
                        <i data-lucide="book-open" class="h-[18px] w-[18px]"></i> My courses
                        <span class="ml-auto rounded-lg bg-white/10 px-2 py-0.5 text-xs">
                            <%= courseCount %>
                        </span>
                    </a>
                    <a href="#notes"
                        class="sidebar-link flex items-center gap-3 rounded-xl px-4 py-3 text-sm text-slate-300">
                        <i data-lucide="notebook-text" class="h-[18px] w-[18px]"></i> Study notes
                    </a>
                    <a href="#quizzes"
                        class="sidebar-link flex items-center gap-3 rounded-xl px-4 py-3 text-sm text-slate-300">
                        <i data-lucide="clipboard-check" class="h-[18px] w-[18px]"></i> Quizzes & exams
                    </a>
                    <a href="#progress"
                        class="sidebar-link flex items-center gap-3 rounded-xl px-4 py-3 text-sm text-slate-300">
                        <i data-lucide="chart-no-axes-column-increasing" class="h-[18px] w-[18px]"></i> Learning
                        progress
                    </a>
                </nav>

                <div class="px-5 pt-8 pb-3">
                    <p class="px-3 text-[10px] font-bold uppercase tracking-[.2em] text-slate-500">Account</p>
                </div>
                <nav class="px-4 space-y-1.5">
                    <a href="#profile"
                        class="sidebar-link flex items-center gap-3 rounded-xl px-4 py-3 text-sm text-slate-300">
                        <i data-lucide="user-round" class="h-[18px] w-[18px]"></i> My profile
                    </a>
                    <a href="#password"
                        class="sidebar-link flex items-center gap-3 rounded-xl px-4 py-3 text-sm text-slate-300">
                        <i data-lucide="shield-check" class="h-[18px] w-[18px]"></i> Security
                    </a>
                </nav>

                <div class="mt-auto p-5">
                    <div class="rounded-2xl border border-white/10 bg-white/[.06] p-4">
                        <div class="flex items-center gap-2 text-indigo-200">
                            <i data-lucide="sparkles" class="h-4 w-4"></i>
                            <span class="text-xs font-semibold">Keep moving forward</span>
                        </div>
                        <p class="mt-2 text-xs leading-5 text-slate-400">Small steps every day lead to big achievements.
                        </p>
                        <p class="mt-4 text-[10px] tracking-wide text-slate-500">LEARN · GROW · ACHIEVE</p>
                    </div>
                </div>
            </aside>

            <!-- Main area -->
            <div class="min-w-0 flex-1 md:ml-72">

                <!-- Top bar -->
                <header class="sticky top-0 z-30 border-b border-slate-200/80 bg-white/90 backdrop-blur-xl">
                    <div
                        class="mx-auto flex max-w-[1500px] items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-9">
                        <div class="flex items-center gap-3">
                            <div
                                class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-indigo-700 md:hidden">
                                <i data-lucide="graduation-cap" class="h-5 w-5"></i>
                            </div>
                            <div>
                                <p class="text-xs font-medium text-slate-400">STUDENT PORTAL</p>
                                <h1 class="text-lg font-bold tracking-tight text-slate-900 sm:text-xl">My learning
                                    dashboard</h1>
                            </div>
                        </div>

                        <div class="flex items-center gap-3">
                            <div class="hidden text-right sm:block">
                                <p class="text-sm font-semibold text-slate-800">
                                    <%= displayName %>
                                </p>
                                <p class="text-xs text-slate-500">Class <%= student.class %>
                                </p>
                            </div>
                            <div
                                class="flex h-10 w-10 items-center justify-center rounded-full bg-indigo-100 font-bold text-indigo-700">
                                <%= displayName.charAt(0).toUpperCase() %>
                            </div>
                            <form action="/student/logout" method="POST">
                                <button type="submit"
                                    class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-600 transition hover:border-rose-200 hover:bg-rose-50 hover:text-rose-600">
                                    <i data-lucide="log-out" class="h-4 w-4"></i>
                                    <span class="hidden sm:inline">Logout</span>
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Mobile navigation -->
                    <nav class="flex gap-2 overflow-x-auto border-t border-slate-100 px-4 py-2.5 md:hidden">
                        <a href="#overview"
                            class="shrink-0 rounded-lg bg-indigo-600 px-3 py-2 text-xs font-semibold text-white">Overview</a>
                        <a href="#courses"
                            class="shrink-0 rounded-lg bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-600">Courses</a>
                        <a href="#notes"
                            class="shrink-0 rounded-lg bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-600">Notes</a>
                        <a href="#quizzes"
                            class="shrink-0 rounded-lg bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-600">Quizzes</a>
                        <a href="#progress"
                            class="shrink-0 rounded-lg bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-600">Progress</a>
                        <a href="#profile"
                            class="shrink-0 rounded-lg bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-600">Profile</a>
                    </nav>
                </header>

                <main class="mx-auto max-w-[1500px] px-4 py-7 sm:px-6 lg:px-9 lg:py-9">

                    <!-- Welcome hero -->
                    <section id="overview"
                        class="relative isolate mb-7 overflow-hidden rounded-[28px] bg-gradient-to-br from-[#242b59] via-[#343d83] to-[#5b5bd6] p-6 text-white shadow-xl shadow-indigo-950/10 sm:p-9">
                        <div
                            class="absolute -right-16 -top-24 -z-10 h-72 w-72 rounded-full border-[35px] border-white/5">
                        </div>
                        <div
                            class="absolute -bottom-28 right-36 -z-10 h-64 w-64 rounded-full bg-indigo-300/10 blur-2xl">
                        </div>
                        <div class="max-w-3xl">
                            <div
                                class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-semibold text-indigo-100">
                                <i data-lucide="sun" class="h-3.5 w-3.5"></i>
                                YOUR LEARNING JOURNEY
                            </div>
                            <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Hello, <%= firstName %>!
                                    <span aria-hidden="true">👋</span></h2>
                            <p class="mt-3 max-w-xl text-sm leading-6 text-indigo-100 sm:text-base">Every lesson brings
                                you one step closer to your goals. Stay curious, stay consistent and make today count.
                            </p>
                            <a href="#courses"
                                class="mt-6 inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-bold text-indigo-700 shadow-lg transition hover:-translate-y-0.5 hover:bg-indigo-50">
                                Explore my courses <i data-lucide="arrow-up-right" class="h-4 w-4"></i>
                            </a>
                        </div>
                        <div
                            class="mt-8 grid grid-cols-2 gap-3 sm:absolute sm:bottom-8 sm:right-8 sm:mt-0 sm:w-[330px]">
                            <div class="rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur">
                                <p class="text-xs text-indigo-100">Your class</p>
                                <p class="mt-1 text-2xl font-bold">
                                    <%= student.class %>
                                </p>
                            </div>
                            <div class="rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur">
                                <p class="text-xs text-indigo-100">Account status</p>
                                <div class="mt-2 flex items-center gap-2 text-lg font-bold">
                                    <span
                                        class="h-2.5 w-2.5 rounded-full <%= accountIsActive ? 'bg-emerald-400' : 'bg-rose-400' %>"></span>
                                    <%= accountIsActive ? "Active" : "Inactive" %>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Summary cards -->
                    <section class="mb-9 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                        <div class="soft-card rounded-2xl border border-slate-100 bg-white p-5">
                            <div class="flex items-center justify-between">
                                <div
                                    class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
                                    <i data-lucide="book-open" class="h-5 w-5"></i></div>
                                <span class="text-xs font-medium text-slate-400">Available to you</span>
                            </div>
                            <p class="mt-4 text-3xl font-extrabold text-slate-900">
                                <%= courseCount %>
                            </p>
                            <p class="mt-1 text-sm font-medium text-slate-500">Published courses</p>
                        </div>
                        <div class="soft-card rounded-2xl border border-slate-100 bg-white p-5">
                            <div class="flex items-center justify-between">
                                <div
                                    class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                                    <i data-lucide="badge-check" class="h-5 w-5"></i></div>
                                <span class="text-xs font-medium text-slate-400">Account</span>
                            </div>
                            <p
                                class="mt-4 text-2xl font-extrabold <%= accountIsActive ? 'text-emerald-600' : 'text-rose-600' %>">
                                <%= accountIsActive ? "Active" : "Inactive" %>
                            </p>
                            <p class="mt-1 text-sm font-medium text-slate-500">Student membership</p>
                        </div>
                        <div
                            class="soft-card rounded-2xl border border-slate-100 bg-white p-5 sm:col-span-2 xl:col-span-1">
                            <div class="flex items-center justify-between">
                                <div
                                    class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                                    <i data-lucide="calendar-days" class="h-5 w-5"></i></div>
                                <span class="text-xs font-medium text-slate-400">Since joining</span>
                            </div>
                            <p class="mt-4 text-2xl font-extrabold text-slate-900">
                                <%= new Date(student.createdAt).toLocaleDateString("en-IN", { day: "2-digit" ,
                                    month: "short" , year: "numeric" }) %>
                            </p>
                            <p class="mt-1 text-sm font-medium text-slate-500">Member since</p>
                        </div>
                    </section>

                    <!-- Courses -->
                    <section id="courses" class="mb-10 scroll-mt-28">
                        <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
                            <div>
                                <p class="text-xs font-bold uppercase tracking-[.18em] text-indigo-600">Keep learning
                                </p>
                                <h2 class="mt-1 text-2xl font-extrabold tracking-tight text-slate-900">My courses</h2>
                                <p class="mt-1 text-sm text-slate-500">Courses published for your class.</p>
                            </div>
                            <span class="rounded-full bg-indigo-50 px-3.5 py-2 text-xs font-bold text-indigo-700">
                                <%= courseCount %>
                                    <%= courseCount===1 ? "course" : "courses" %>
                            </span>
                        </div>

                        <% if (courseCount> 0) { %>
                            <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
                                <% courses.forEach((course, index)=> { %>
                                    <article
                                        class="group overflow-hidden rounded-2xl border border-slate-100 bg-white soft-card transition duration-300 hover:-translate-y-1 hover:shadow-xl">
                                        <div
                                            class="relative h-44 overflow-hidden bg-gradient-to-br from-indigo-600 via-violet-600 to-blue-500">
                                            <% if (course.thumbnail) { %>
                                                <img src="<%= course.thumbnail %>" alt="<%= course.title %>"
                                                    class="h-full w-full object-cover transition duration-500 group-hover:scale-105">
                                                <% } else { %>
                                                    <div class="flex h-full items-center justify-center">
                                                        <div
                                                            class="flex h-16 w-16 items-center justify-center rounded-2xl border border-white/20 bg-white/15 text-2xl font-black text-white backdrop-blur">
                                                            EC</div>
                                                    </div>
                                                    <% } %>
                                                        <span
                                                            class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1 text-[11px] font-bold text-indigo-700">
                                                            <%= course.subject %>
                                                        </span>
                                        </div>
                                        <div class="p-5">
                                            <div class="mb-2 flex items-center justify-between gap-2">
                                                <span class="text-xs font-semibold text-slate-400">COURSE <%=
                                                        String(index + 1).padStart(2, "0" ) %></span>
                                                <span class="text-xs text-slate-400">
                                                    <%= course.class %>
                                                </span>
                                            </div>
                                            <h3 class="text-lg font-bold leading-snug text-slate-900">
                                                <%= course.title %>
                                            </h3>
                                            <p class="mt-2 text-sm leading-6 text-slate-500">
                                                <%= course.description %>
                                            </p>

                                            <div
                                                class="mt-5 flex   items-center justify-between border-t border-slate-100 pt-4">

                                                <span
                                                    class="inline-flex items-center gap-1.5 text-xs font-medium text-emerald-600">
                                                    <i data-lucide="check-circle-2" class="h-4 w-4"></i>
                                                    Available
                                                </span>

                                                <a href="/student/courses/<%= course._id %>"
                                                    class="inline-flex items-center gap-1  text-xs font-bold text-indigo-600 hover:text-indigo-800 transition">

                                                    View course

                                                    <i data-lucide="arrow-right" class="h-3.5 w-3.5"></i>

                                                </a>

                                            </div>

                                        </div>
                                    </article>
                                    <% }) %>
                            </div>
                            <% } else { %>
                                <div
                                    class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center">
                                    <div
                                        class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">
                                        <i data-lucide="book-open" class="h-6 w-6"></i></div>
                                    <h3 class="mt-4 text-lg font-bold text-slate-900">Your learning library is getting
                                        ready</h3>
                                    <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">There are no
                                        published courses for your class right now. Please check again soon.</p>
                                </div>
                                <% } %>
                    </section>

                    <!-- Learning tools - placeholders until backend is implemented -->
                    <section class="mb-10">
                        <div class="mb-5">
                            <p class="text-xs font-bold uppercase tracking-[.18em] text-indigo-600">More for your growth
                            </p>
                            <h2 class="mt-1 text-2xl font-extrabold tracking-tight text-slate-900">Learning tools</h2>
                            <p class="mt-1 text-sm text-slate-500">New ways to practise and track your learning will be
                                added here.</p>
                        </div>
                        <div class="grid gap-4 lg:grid-cols-3">
                            <article id="notes"
                                class="scroll-mt-28 rounded-2xl border border-slate-100 bg-white p-5 soft-card">
                                <div
                                    class="flex h-11 w-11 items-center justify-center rounded-xl bg-sky-50 text-sky-600">
                                    <i data-lucide="notebook-text" class="h-5 w-5"></i></div>
                                <h3 class="mt-4 font-bold text-slate-900">Study notes</h3>
                                <p class="mt-1 text-sm leading-6 text-slate-500">Organised notes and downloadable study
                                    materials for your subjects.</p>
                                <span
                                    class="mt-4 inline-flex rounded-full bg-amber-50 px-3 py-1 text-[11px] font-bold text-amber-700">Coming
                                    soon</span>
                            </article>
                            <article id="quizzes"
                                class="scroll-mt-28 rounded-2xl border border-slate-100 bg-white p-5 soft-card">
                                <div
                                    class="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-50 text-violet-600">
                                    <i data-lucide="clipboard-check" class="h-5 w-5"></i></div>
                                <h3 class="mt-4 font-bold text-slate-900">Quizzes & exams</h3>
                                <p class="mt-1 text-sm leading-6 text-slate-500">Test your understanding with practice
                                    quizzes and assessments.</p>
                                <span
                                    class="mt-4 inline-flex rounded-full bg-amber-50 px-3 py-1 text-[11px] font-bold text-amber-700">Coming
                                    soon</span>
                            </article>
                            <article id="progress"
                                class="scroll-mt-28 rounded-2xl border border-slate-100 bg-white p-5 soft-card">
                                <div
                                    class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                                    <i data-lucide="chart-no-axes-column-increasing" class="h-5 w-5"></i></div>
                                <h3 class="mt-4 font-bold text-slate-900">Learning progress</h3>
                                <p class="mt-1 text-sm leading-6 text-slate-500">See your learning activity and course
                                    completion in one place.</p>
                                <span
                                    class="mt-4 inline-flex rounded-full bg-amber-50 px-3 py-1 text-[11px] font-bold text-amber-700">Coming
                                    soon</span>
                            </article>
                        </div>
                    </section>

                    <!-- Profile and security -->
                    <section class="mb-10 grid gap-5 xl:grid-cols-2">
                        <div id="profile"
                            class="scroll-mt-28 rounded-2xl border border-slate-100 bg-white p-5 soft-card sm:p-6">
                            <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
                                <div>
                                    <p class="text-xs font-bold uppercase tracking-[.18em] text-indigo-600">Your account
                                    </p>
                                    <h2 class="mt-1 text-xl font-extrabold text-slate-900">Personal profile</h2>
                                </div>
                                <button id="editProfileBtn" type="button"
                                    class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-700">
                                    <i data-lucide="pencil" class="h-4 w-4"></i> Edit profile
                                </button>
                            </div>

                            <div id="profileDetails" class="grid gap-5 sm:grid-cols-2">
                                <div class="rounded-xl bg-slate-50 p-4">
                                    <p class="text-xs font-medium text-slate-400">Full name</p>
                                    <p class="mt-1 break-words text-sm font-bold text-slate-800">
                                        <%= student.fullName %>
                                    </p>
                                </div>
                                <div class="rounded-xl bg-slate-50 p-4">
                                    <p class="text-xs font-medium text-slate-400">Email address</p>
                                    <p class="mt-1 break-all text-sm font-bold text-slate-800">
                                        <%= student.email %>
                                    </p>
                                </div>
                                <div class="rounded-xl bg-slate-50 p-4">
                                    <p class="text-xs font-medium text-slate-400">Class</p>
                                    <p class="mt-1 text-sm font-bold text-slate-800">
                                        <%= student.class %>
                                    </p>
                                </div>
                                <div class="rounded-xl bg-slate-50 p-4">
                                    <p class="text-xs font-medium text-slate-400">Member since</p>
                                    <p class="mt-1 text-sm font-bold text-slate-800">
                                        <%= new Date(student.createdAt).toLocaleDateString("en-IN", { day: "2-digit" ,
                                            month: "long" , year: "numeric" }) %>
                                    </p>
                                </div>
                            </div>

                            <form id="editProfileForm" class="mt-5 hidden space-y-4">
                                <div>
                                    <label for="fullName" class="mb-1.5 block text-sm font-semibold text-slate-700">Full
                                        name</label>
                                    <input type="text" id="fullName" value="<%= student.fullName %>" required
                                        minlength="2" maxlength="60" class="field">
                                </div>
                                <div>
                                    <label for="email" class="mb-1.5 block text-sm font-semibold text-slate-700">Email
                                        address</label>
                                    <input type="email" id="email" value="<%= student.email %>" required class="field">
                                </div>
                                <p id="profileMessage" class="text-sm" role="status" aria-live="polite"></p>
                                <div class="flex flex-wrap gap-2">
                                    <button type="submit" id="saveProfileBtn"
                                        class="rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700">Save
                                        changes</button>
                                    <button type="button" id="cancelEditBtn"
                                        class="rounded-xl bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-200">Cancel</button>
                                </div>
                            </form>
                        </div>

                        <div id="password"
                            class="scroll-mt-28 rounded-2xl border border-slate-100 bg-white p-5 soft-card sm:p-6">
                            <div class="mb-6">
                                <p class="text-xs font-bold uppercase tracking-[.18em] text-indigo-600">Account
                                    protection</p>
                                <h2 class="mt-1 text-xl font-extrabold text-slate-900">Change password</h2>
                                <p class="mt-1 text-sm text-slate-500">Use a strong password to keep your account
                                    secure.</p>
                            </div>
                            <form id="changePasswordForm" class="space-y-4">
                                <div>
                                    <label for="currentPassword"
                                        class="mb-1.5 block text-sm font-semibold text-slate-700">Current
                                        password</label>
                                    <input type="password" id="currentPassword" required autocomplete="current-password"
                                        class="field" placeholder="Enter current password">
                                </div>
                                <div>
                                    <label for="newPassword"
                                        class="mb-1.5 block text-sm font-semibold text-slate-700">New password</label>
                                    <input type="password" id="newPassword" required minlength="8"
                                        autocomplete="new-password" class="field" placeholder="At least 8 characters">
                                </div>
                                <div>
                                    <label for="confirmPassword"
                                        class="mb-1.5 block text-sm font-semibold text-slate-700">Confirm new
                                        password</label>
                                    <input type="password" id="confirmPassword" required minlength="8"
                                        autocomplete="new-password" class="field" placeholder="Re-enter new password">
                                </div>
                                <p id="passwordMessage" class="text-sm" role="status" aria-live="polite"></p>
                                <button type="submit"
                                    class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-700">
                                    <i data-lucide="lock-keyhole" class="h-4 w-4"></i> Update password
                                </button>
                            </form>
                        </div>
                    </section>

                    <footer class="border-t border-slate-200 py-6 text-center text-xs text-slate-400">
                        © <%= new Date().getFullYear() %> Excellence Club. Learn · Grow · Achieve.
                    </footer>

                </main>
            </div>
        </div>

        <script>
            // Activate Lucide icons.
            if (window.lucide) {
                window.lucide.createIcons();
            }

            // Sidebar active state for section navigation.
            const sidebarLinks = document.querySelectorAll(".sidebar-link");
            sidebarLinks.forEach((link) => {
                link.addEventListener("click", () => {
                    sidebarLinks.forEach((item) => item.classList.remove("active"));
                    link.classList.add("active");
                });
            });

            // Profile editing.
            const editProfileBtn = document.getElementById("editProfileBtn");
            const editProfileForm = document.getElementById("editProfileForm");
            const profileDetails = document.getElementById("profileDetails");
            const cancelEditBtn = document.getElementById("cancelEditBtn");
            const profileMessage = document.getElementById("profileMessage");
            const saveProfileBtn = document.getElementById("saveProfileBtn");

            if (editProfileBtn && editProfileForm && profileDetails && cancelEditBtn) {
                editProfileBtn.addEventListener("click", () => {
                    editProfileForm.classList.remove("hidden");
                    profileDetails.classList.add("hidden");
                    editProfileBtn.classList.add("hidden");
                });

                cancelEditBtn.addEventListener("click", () => {
                    editProfileForm.reset();
                    editProfileForm.classList.add("hidden");
                    profileDetails.classList.remove("hidden");
                    editProfileBtn.classList.remove("hidden");
                    if (profileMessage) profileMessage.textContent = "";
                });

                editProfileForm.addEventListener("submit", async (event) => {
                    event.preventDefault();

                    saveProfileBtn.disabled = true;
                    saveProfileBtn.textContent = "Saving...";
                    profileMessage.textContent = "";

                    const fullName = document.getElementById("fullName").value.trim();
                    const email = document.getElementById("email").value.trim();

                    try {
                        const response = await fetch("/api/student/profile/update", {
                            method: "PUT",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ fullName, email })
                        });

                        const data = await response.json();
                        if (!response.ok) {
                            throw new Error(data.message || "Profile update failed.");
                        }

                        profileMessage.textContent = data.message || "Profile updated successfully.";
                        profileMessage.className = "text-sm text-emerald-600";
                        setTimeout(() => window.location.reload(), 900);
                    } catch (error) {
                        profileMessage.textContent = error.message;
                        profileMessage.className = "text-sm text-rose-600";
                    } finally {
                        saveProfileBtn.disabled = false;
                        saveProfileBtn.textContent = "Save changes";
                    }
                });
            }

            // Password change.
            const changePasswordForm = document.getElementById("changePasswordForm");

            if (changePasswordForm) {
                changePasswordForm.addEventListener("submit", async (event) => {
                    event.preventDefault();

                    const currentPassword = document.getElementById("currentPassword").value;
                    const newPassword = document.getElementById("newPassword").value;
                    const confirmPassword = document.getElementById("confirmPassword").value;
                    const passwordMessage = document.getElementById("passwordMessage");
                    const submitBtn = changePasswordForm.querySelector("button[type='submit']");

                    passwordMessage.textContent = "";

                    if (newPassword !== confirmPassword) {
                        passwordMessage.textContent = "New password and confirmation do not match.";
                        passwordMessage.className = "text-sm text-rose-600";
                        return;
                    }

                    submitBtn.disabled = true;
                    submitBtn.textContent = "Updating...";

                    try {
                        const response = await fetch("/student/password/change", {
                            method: "PUT",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ currentPassword, newPassword, confirmPassword })
                        });

                        const data = await response.json();
                        if (!response.ok) {
                            throw new Error(data.message || "Password update failed.");
                        }

                        passwordMessage.textContent = data.message || "Password updated successfully.";
                        passwordMessage.className = "text-sm text-emerald-600";
                        changePasswordForm.reset();
                    } catch (error) {
                        passwordMessage.textContent = error.message;
                        passwordMessage.className = "text-sm text-rose-600";
                    } finally {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i data-lucide="lock-keyhole" class="h-4 w-4"></i> Update password';
                        if (window.lucide) window.lucide.createIcons();
                    }
                });
            }
        </script>

</body>

</html>