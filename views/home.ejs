
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Excellence Club | Learn • Grow • Achieve</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-50">

    <nav class="bg-slate-950 text-white px-8 py-5">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <h1 class="text-2xl font-bold">
                Excellence<span class="text-blue-400">Club.</span>
            </h1>

            <div class="hidden md:flex gap-8">
                <a href="/" class="hover:text-blue-400">Home</a>
                <a href="#about" class="hover:text-blue-400">About</a>
                <a href="#courses" class="hover:text-blue-400">Courses</a>
                <a href="#contact" class="hover:text-blue-400">Contact</a>
            </div>

            <a href="#courses"
               class="bg-blue-600 px-5 py-2 rounded-lg hover:bg-blue-700">
                Explore
            </a>
        </div>
    </nav>

    <main class="min-h-[80vh] flex items-center justify-center px-6">
        <section class="text-center max-w-3xl">

            <p class="text-blue-600 font-semibold mb-4">
                LEARN • GROW • ACHIEVE
            </p>

            <h2 class="text-4xl md:text-6xl font-bold text-slate-900 leading-tight">
                Unlock Your Potential with
                <span class="text-blue-600">Excellence Club</span>
            </h2>

            <p class="text-gray-600 text-lg mt-6">
                A learning community for students of Classes 9th to 12th.
                Learn together, grow together and achieve excellence.
            </p>

            <div class="flex flex-wrap justify-center gap-4 mt-8">
                <a href="#courses"
                   class="bg-blue-600 text-white px-7 py-3 rounded-lg">
                    Explore Courses
                </a>

                <a href="#about"
                   class="border border-slate-400 px-7 py-3 rounded-lg">
                    Learn More
                </a>
            </div>

        </section>
    </main>

    <footer class="bg-slate-950 text-white text-center py-6">
        <p>© 2026 Excellence Club. Learn • Grow • Achieve.</p>
    </footer>

</body>
</html>
